<?xml version="1.0" encoding="utf-8"?>
<!--
  LoupixDeck.PluginSdk 1.30.0 is not on nuget.org yet, so it is restored from a local build of the
  SDK: a LoupixDeck checkout next to this repository (../LoupixDeck, with the SDK submodule built
  once: dotnet build ../LoupixDeck/LoupixDeck.PluginSdk -c Release). CI builds the SDK into the
  same place. Drop the local source once 1.30.0 is published; a missing local folder fails restore.
-->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="LoupixDeckSdkLocal" value="../LoupixDeck/LoupixDeck.PluginSdk/nupkg" />
  </packageSources>
</configuration>
